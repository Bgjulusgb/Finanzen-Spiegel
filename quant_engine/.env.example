# Quant Engine - Beispiel-Konfiguration
# Datei nach .env kopieren und Werte anpassen.

# Server
QUANT_HOST=0.0.0.0
QUANT_PORT=8080
QUANT_LOG_LEVEL=INFO

# Datenbank (Pfad relativ zum Projekt-Root, oder absolut)
QUANT_DB_PATH=./data/quant.db

# Cache TTL (Sekunden)
QUANT_CACHE_TTL_PRICE=300
QUANT_CACHE_TTL_FEED=600
QUANT_CACHE_TTL_NLP=86400

# Asset (Default-Asset, das beim Start geladen wird)
QUANT_ASSET_SYMBOL=NVDA
QUANT_ASSET_NAME=NVIDIA Corporation

# NLP - optionale schwere Modelle aus (Standard)
QUANT_USE_FINBERT=0
QUANT_USE_SENTENCE_TRANSFORMERS=0

# Scheduler-Intervalle (Minuten)
QUANT_SCHEDULE_PRICES_MIN=5
QUANT_SCHEDULE_FEEDS_MIN=15
QUANT_SCHEDULE_ANALYSIS_MIN=10

# HTTP
QUANT_HTTP_TIMEOUT=20
QUANT_HTTP_USER_AGENT=QuantEngine/0.1 (open-source research bot; contact: local-deployment)
