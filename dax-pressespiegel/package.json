{
  "name": "dax-pressespiegel",
  "version": "0.3.0",
  "description": "Lokaler Stimmungs-Pressespiegel fuer den DAX 40 - Mood, Bull/Bear, Talk-Type, Buzz, Trend, Konsens. Zero native compilation: nutzt das in Node eingebaute node:sqlite.",
  "main": "src/server.js",
  "bin": {
    "dax-pressespiegel": "./bin/cli.js"
  },
  "scripts": {
    "start": "node --experimental-sqlite --no-warnings=ExperimentalWarning bin/cli.js ui",
    "ui": "node --experimental-sqlite --no-warnings=ExperimentalWarning bin/cli.js ui",
    "scan": "node --experimental-sqlite --no-warnings=ExperimentalWarning bin/cli.js scan",
    "list": "node --experimental-sqlite --no-warnings=ExperimentalWarning bin/cli.js list",
    "inspect": "node --experimental-sqlite --no-warnings=ExperimentalWarning scripts/inspect.js",
    "test": "node --experimental-sqlite --no-warnings=ExperimentalWarning --test tests/*.test.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "express": "^4.21.2",
    "rss-parser": "^3.13.0",
    "undici": "^7.2.0"
  },
  "license": "MIT"
}
